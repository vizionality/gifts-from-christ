# Public WordPress origin. No trailing slash.
NEXT_PUBLIC_WP_URL=http://localhost:8080

# Must match HEADLESS_HANDOFF_SECRET in docker-compose.yml / your WP config.
# Generate a real one with: openssl rand -hex 32
WP_HANDOFF_SECRET=dev-only-insecure-secret

# Seconds Next caches catalogue data before revalidating.
NEXT_PUBLIC_REVALIDATE_SECONDS=60

# Optional: shared secret for the WooCommerce webhook that purges the cache.
# Set the same value in WooCommerce > Settings > Advanced > Webhooks.
WC_WEBHOOK_SECRET=

# GA4 measurement id, e.g. G-XXXXXXXXXX. Leave empty in development so test
# traffic never reaches the property used to decide bulk purchasing.
NEXT_PUBLIC_GA_ID=

# Canonical public origin of the storefront. No trailing slash.
# Production: https://giftsfromchrist.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
